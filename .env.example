# Copia este archivo a .env y rellena los valores reales.
#   cp .env.example .env
# El .env NO se commitea.

# Token GSLT de Steam para App ID 227300 (ETS2).
# Sin un token valido el server arranca anonimo y genera un ID NUEVO
# en cada reinicio (no persistente).
# Generar en: https://steamcommunity.com/dev/managegameservers
ETS_SERVER_LOGON_TOKEN=

# Token del endpoint HTTP del monitor (vacio = abierto).
MONITOR_TOKEN=

# Webhook de Discord para avisos de conexion/desconexion (vacio = desactivado).
DISCORD_WEBHOOK_URL=
